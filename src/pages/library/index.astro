---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import Section from '@components/Section.astro';
import LibraryBrowser from '@components/LibraryBrowser.astro';
import data from '../../data/library.json';

const n = data.documents.length;
const hosted = data.documents.filter((d) => d.href).length;
const title = 'Biochar library: research, reports and field results';
const description = `${n} publications on biochar in soil, crops, livestock feed, turf, council greenspace, water and remediation, compost, carbon and production, each summarised for the people who would use it. Search by crop, animal, place or topic.`;
---

<BaseLayout
  title={title}
  description={description}
  enquiryRailHeading="Know of a paper or a trial report that belongs here?"
  enquiryRailCta="Send it through"
>
  <Hero
    layout="split"
    eyebrow="The Possible Agriculture biochar library"
    heading="Research, reports and field results on biochar."
    lead={`${n} publications gathered from the journals, the research institutes, the industry bodies and producers overseas who have put biochar into paddocks, rations, greens and filters and measured what happened. Each one is summarised for the person who would use it. Search for a crop, an animal, a soil or a place, or pick a topic.`}
    primaryCta={{ label: 'Browse the library', href: '#papers' }}
    secondaryCta={{ label: 'Suggest a paper', href: '/contact?subject=research-question' }}
    image="/images/hero/library.jpg"
    imageAlt="Research papers, brochures, and a biochar sample jar on a working desk in late afternoon light"
  />

  <Section id="papers" container="default" spacing="default">
    <LibraryBrowser />
  </Section>

  <Section container="narrow" variant="tint" spacing="default" eyebrow="About the collection" heading="What is here, and why.">
    <div class="prose prose-pa">
      <p>
        Every document here reports a result in favour of biochar for the use it studied. Work whose findings were neutral or went the other way is not listed, so this is a case for biochar, not a survey of everything written about it. The {hosted} documents held on this site are open access papers, government and industry reports, and producer articles published for free public use; each file carries its own copyright notice, and the original is linked beside it. Papers behind a publisher paywall are linked to the publisher. Summaries are ours, written from the documents, not quotations from them.
      </p>
      <p>
        No Australian biochar seller is linked from this page. Overseas producers appear where they have published trial results with named sites, rates and measured outcomes.
      </p>
      <p>
        Know of a paper, a trial or a council report that belongs here? <a href="/contact?subject=research-question">Send it through</a>.
      </p>
    </div>
  </Section>
</BaseLayout>
